<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/ipo_company"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/ipo_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/ipo_company"
        app:layout_constraintStart_toStartOf="@id/ipo_company" />

    <TextView
        android:id="@+id/ipo_exchange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="italic"
        android:textColor="@android.color/darker_gray"
        app:layout_constraintTop_toBottom_of="@id/ipo_symbol"
        app:layout_constraintStart_toStartOf="@id/ipo_company" />

    <TextView
        android:id="@+id/ipo_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@android:color/darker_gray"
        android:maxLines="1"
        app:layout_constraintTop_toBottom_of="@id/ipo_exchange"
        app:layout_constraintStart_toStartOf="@id/ipo_company"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/ipo_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:paddingHorizontal="4dp"
        android:background="@drawable/bg_price_tag"
        android:minWidth="36dp"
        android:minHeight="14dp"
        app:layout_constraintTop_toBottom_of="@id/ipo_date"
        app:layout_constraintStart_toStartOf="@id/ipo_company" />

</androidx.constraintlayout.widget.ConstraintLayout>