<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?android:attr/colorBackgroundFloating">

    <TextView
        android:id="@+id/calendar_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/calendar_event"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/calendar_time"
        app:layout_constraintEnd_toStartOf="@id/calendar_currency"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/calendar_currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@android:color/holo_blue_dark"
        android:background="@android:color/transparent"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintTop_toTopOf="@id/calendar_event"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/calendar_impact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@android:color/holo_red_dark"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        app:layout_constraintTop_toBottomOf="@id/calendar_event"
        app:layout_constraintStart_toStartOf="@id/calendar_time" />

    <TextView
        android:id="@+id/calendar_actual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@android:color/darker_gray"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/calendar_event"
        app:layout_constraintStart_toEndOf="@id/calendar_impact"
        app:layout_constraintEnd_toEndOf="@id/calendar_currency"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/calendar_forecast"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@android:color/darker_gray"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/calendar_event"
        app:layout_constraintStart_toEndOf="@id/calendar_actual"
        app:layout_constraintEnd_toEndOf="@id/calendar_currency"
        android:layout_marginStart="4dp" />

    <TextView
        android:id="@+id/calendar_previous"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@android:color/darker_gray"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/calendar_actual"
        app:layout_constraintStart_toStartOf="@id/calendar_actual"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>